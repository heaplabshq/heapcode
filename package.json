{
  "name": "cortexcode",
  "private": true,
  "version": "0.1.0",
  "description": "Cortex Code — model-agnostic AI coding assistant for VS Code",
  "scripts": {
    "build": "pnpm --filter @cortex/webview-ui build && pnpm --filter cortex-code build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
