  "devDependencies": {
    "@types/ws": "^8.5.12",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
