    "ink-spinner": "^5.0.0",
    "marked": "^14.1.0",
    "marked-terminal": "^7.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "esbuild": "^0.23.1",
    "ink-testing-library": "^4.0.0",
