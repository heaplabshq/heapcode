{
  "name": "@heapcode/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "default": "./src/providers/index.ts"
    },
    "./context": {
      "types": "./src/context/index.ts",
      "default": "./src/context/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./modelFilter": {
      "types": "./src/providers/modelFilter.ts",
      "default": "./src/providers/modelFilter.ts"
    },
    "./permissionModes": {
      "types": "./src/agent/permissionModes.ts",
      "default": "./src/agent/permissionModes.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heapcode/repomap": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ignore": "^7.0.5",
    "web-tree-sitter": "^0.25.6"
  },
  "devDependencies": {
    "tree-sitter-wasms": "^0.1.12",
    "typescript": "^5.5.4"
  }
}
