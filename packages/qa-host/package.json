{
  "name": "@heapcode/qa-host",
  "version": "0.1.0",
  "private": true,
  "description": "Heap QA's host: running, exploring, recording and AI tasks for both the terminal and the app, and the session the app talks to.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
