    "@heapcode/qa-playwright": "workspace:*",
    "@heapcode/web-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
