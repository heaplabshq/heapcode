{
  "name": "cortex-code",
  "displayName": "Cortex Code",
  "description": "Model-agnostic AI coding assistant. Works with any OpenAI-compatible API — Ollama, OpenAI, OpenRouter, Groq, LM Studio, vLLM, and more.",
  "version": "0.1.0",
  "publisher": "cortexcode",
  "private": true,
  "license": "SEE LICENSE FILE",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth7631/cortexcode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Chat", "Programming Languages"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortex",
          "title": "Cortex",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cortex": [
        {
          "type": "webview",
          "id": "cortex.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "cortex.openChat",
        "title": "Cortex: Open Chat"
      },
      {
        "command": "cortex.menu",
        "title": "Cortex: Provider Menu"
      },
      {
        "command": "cortex.selectProfile",
        "title": "Cortex: Switch Profile"
      },
      {
        "command": "cortex.addProfile",
        "title": "Cortex: Add Provider Profile"
      },
      {
        "command": "cortex.selectModel",
        "title": "Cortex: Select Model"
      },
      {
        "command": "cortex.setApiKey",
        "title": "Cortex: Set API Key (Active Profile)"
      }
    ],
    "configuration": {
      "title": "Cortex Code",
      "properties": {
        "cortex.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named provider profiles. Each item: `{ name, preset, baseUrl, model, temperature?, maxTokens?, headers?, capabilities? }`. API keys are NOT stored here — use the *Cortex: Set API Key* command (OS keychain). Presets: `openai`, `ollama`, `azure-openai`, `openrouter`, `together`, `groq`, `nvidia-nim`, `lmstudio`, `vllm`, `localai`, `custom`.",
          "items": {
            "type": "object",
            "required": ["name", "preset", "baseUrl", "model"],
            "properties": {
              "name": { "type": "string" },
              "preset": {
                "type": "string",
                "enum": ["openai", "ollama", "azure-openai", "openrouter", "together", "groq", "nvidia-nim", "lmstudio", "vllm", "localai", "custom"]
              },
              "baseUrl": { "type": "string" },
              "model": { "type": "string" },
              "completionModel": { "type": "string" },
              "embeddingsModel": { "type": "string" },
              "temperature": { "type": "number" },
              "maxTokens": { "type": "number" },
              "headers": { "type": "object" },
              "capabilities": { "type": "object" }
            }
          }
        },
        "cortex.activeProfile": {
          "type": "string",
          "default": "",
          "description": "Name of the active provider profile. Switch via the status bar."
        },
        "cortex.customPrompts": {
          "type": "array",
          "default": [],
          "markdownDescription": "User prompt library. Each item: `{ command, title, template }` — usable as `/command` in chat. Templates support `{input}` (text after the command) and `{selection}` (current editor selection).",
          "items": {
            "type": "object",
            "required": ["command", "template"],
            "properties": {
              "command": { "type": "string" },
              "title": { "type": "string" },
              "template": { "type": "string" }
            }
          }
        },
        "cortex.baseUrl": {
          "type": "string",
          "default": "http://192.168.29.92:11434/v1",
          "markdownDescription": "Legacy fallback endpoint, used only when `cortex.profiles` is empty. Prefer profiles."
        },
        "cortex.model": {
          "type": "string",
          "default": "fredrezones55/Gemma-4-Uncensored-HauhauCS-Aggressive:latest",
          "markdownDescription": "Legacy fallback model, used only when `cortex.profiles` is empty. Prefer profiles."
        },
        "cortex.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature."
        },
        "cortex.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens to generate per response."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --skip-license -o cortex-code.vsix"
  },
  "dependencies": {
    "@cortex/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
