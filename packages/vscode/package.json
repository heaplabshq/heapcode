{
  "name": "cortex-code",
  "displayName": "Cortex Code",
  "description": "Model-agnostic AI coding assistant. Works with any OpenAI-compatible API — Ollama, OpenAI, OpenRouter, Groq, LM Studio, vLLM, and more.",
  "version": "0.1.0",
  "publisher": "cortexcode",
  "private": true,
  "license": "SEE LICENSE FILE",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth7631/cortexcode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortex",
          "title": "Cortex",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cortex": [
        {
          "type": "webview",
          "id": "cortex.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "cortex.openChat",
        "title": "Cortex: Open Chat"
      },
      {
        "command": "cortex.menu",
        "title": "Cortex: Provider Menu"
      },
      {
        "command": "cortex.selectProfile",
        "title": "Cortex: Switch Profile"
      },
      {
        "command": "cortex.addProfile",
        "title": "Cortex: Add Provider Profile"
      },
      {
        "command": "cortex.selectModel",
        "title": "Cortex: Select Model"
      },
      {
        "command": "cortex.setApiKey",
        "title": "Cortex: Set API Key (Active Profile)"
      },
      {
        "command": "cortex.inlineEdit",
        "title": "Cortex: Edit Selection"
      },
      {
        "command": "cortex.explain",
        "title": "Cortex: Explain"
      },
      {
        "command": "cortex.fix",
        "title": "Cortex: Fix"
      },
      {
        "command": "cortex.refactor",
        "title": "Cortex: Refactor"
      },
      {
        "command": "cortex.optimize",
        "title": "Cortex: Optimize"
      },
      {
        "command": "cortex.generateTests",
        "title": "Cortex: Generate Tests"
      },
      {
        "command": "cortex.generateDocs",
        "title": "Cortex: Generate Docs"
      },
      {
        "command": "cortex.reviewCode",
        "title": "Cortex: Review Code"
      },
      {
        "command": "cortex.generateCommitMessage",
        "title": "Cortex: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "cortex.acceptEdit",
        "title": "Accept Cortex Edit",
        "icon": "$(check)"
      },
      {
        "command": "cortex.rejectEdit",
        "title": "Reject Cortex Edit",
        "icon": "$(close)"
      },
      {
        "command": "cortex.toggleCompletion",
        "title": "Cortex: Toggle Completions"
      },
      {
        "command": "cortex.triggerCompletion",
        "title": "Cortex: Trigger Completion"
      },
      {
        "command": "cortex.buildIndex",
        "title": "Cortex: Build/Refresh Semantic Index"
      },
      {
        "command": "cortex.clearIndex",
        "title": "Cortex: Clear Semantic Index"
      },
      {
        "command": "cortex.openMemory",
        "title": "Cortex: Open Project Memory"
      }
    ],
    "submenus": [
      {
        "id": "cortex.submenu",
        "label": "Cortex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cortex.submenu",
          "group": "1_modification@100"
        }
      ],
      "cortex.submenu": [
        {
          "command": "cortex.inlineEdit",
          "group": "1_edit@1"
        },
        {
          "command": "cortex.explain",
          "group": "2_ask@1"
        },
        {
          "command": "cortex.fix",
          "group": "2_ask@2"
        },
        {
          "command": "cortex.refactor",
          "group": "2_ask@3"
        },
        {
          "command": "cortex.optimize",
          "group": "2_ask@4"
        },
        {
          "command": "cortex.reviewCode",
          "group": "2_ask@5"
        },
        {
          "command": "cortex.generateTests",
          "group": "3_generate@1"
        },
        {
          "command": "cortex.generateDocs",
          "group": "3_generate@2"
        }
      ],
      "scm/title": [
        {
          "command": "cortex.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "cortex.acceptEdit",
          "group": "navigation@1",
          "when": "resourceScheme == cortex-proposal"
        },
        {
          "command": "cortex.rejectEdit",
          "group": "navigation@2",
          "when": "resourceScheme == cortex-proposal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cortex.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "cortex.triggerCompletion",
        "key": "alt+\\",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Cortex Code",
      "properties": {
        "cortex.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named provider profiles. Each item: `{ name, preset, baseUrl, model, temperature?, maxTokens?, headers?, capabilities? }`. API keys are NOT stored here — use the *Cortex: Set API Key* command (OS keychain). Presets: `openai`, `ollama`, `azure-openai`, `openrouter`, `together`, `groq`, `nvidia-nim`, `lmstudio`, `vllm`, `localai`, `custom`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "preset",
              "baseUrl",
              "model"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "openai",
                  "ollama",
                  "azure-openai",
                  "openrouter",
                  "together",
                  "groq",
                  "nvidia-nim",
                  "lmstudio",
                  "vllm",
                  "localai",
                  "custom"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "editModel": {
                "type": "string"
              },
              "applyModel": {
                "type": "string"
              },
              "completionModel": {
                "type": "string"
              },
              "agentModel": {
                "type": "string"
              },
              "embeddingsModel": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "maxTokens": {
                "type": "number"
              },
              "headers": {
                "type": "object"
              },
              "capabilities": {
                "type": "object"
              }
            }
          }
        },
        "cortex.activeProfile": {
          "type": "string",
          "default": "",
          "description": "Name of the active provider profile. Switch via the status bar."
        },
        "cortex.customPrompts": {
          "type": "array",
          "default": [],
          "markdownDescription": "User prompt library. Each item: `{ command, title, template }` — usable as `/command` in chat. Templates support `{input}` (text after the command) and `{selection}` (current editor selection).",
          "items": {
            "type": "object",
            "required": [
              "command",
              "template"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "template": {
                "type": "string"
              }
            }
          }
        },
        "cortex.baseUrl": {
          "type": "string",
          "default": "http://192.168.29.92:11434/v1",
          "markdownDescription": "Legacy fallback endpoint, used only when `cortex.profiles` is empty. Prefer profiles."
        },
        "cortex.model": {
          "type": "string",
          "default": "fredrezones55/Gemma-4-Uncensored-HauhauCS-Aggressive:latest",
          "markdownDescription": "Legacy fallback model, used only when `cortex.profiles` is empty. Prefer profiles."
        },
        "cortex.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature."
        },
        "cortex.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens to generate per response."
        },
        "cortex.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline (ghost text) code completions."
        },
        "cortex.completion.delay": {
          "type": "number",
          "default": 250,
          "description": "Debounce in ms before requesting a completion."
        },
        "cortex.completion.maxLines": {
          "type": "number",
          "default": 12,
          "description": "Maximum lines per multi-line completion."
        },
        "cortex.completion.maxTokens": {
          "type": "number",
          "default": 200,
          "description": "Max tokens to generate per completion."
        },
        "cortex.completion.triggerMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "markdownDescription": "`auto`: suggest while typing. `manual`: only on Alt+\\ (Cortex: Trigger Completion)."
        },
        "cortex.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers exposed to the agent. Keyed by name. stdio: `{ \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"/path\"] }` — remote: `{ \"url\": \"https://…\", \"transport\": \"http\" }` (or `sse`). MCP tools go through the same permission prompts as other agent actions.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object" },
              "url": { "type": "string" },
              "transport": { "type": "string", "enum": ["http", "sse"] }
            }
          }
        },
        "cortex.rag.autoIndex": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Index the workspace in the background for semantic search. No-op until the active profile has an `embeddingsModel` (e.g. `nomic-embed-text` on Ollama). Respects `.cortexignore`."
        },
        "cortex.agent.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable agent mode."
        },
        "cortex.agent.planFirst": {
          "type": "boolean",
          "default": true,
          "description": "Agent writes a numbered plan first, then executes it step by step."
        },
        "cortex.agent.maxIterations": {
          "type": "number",
          "default": 25,
          "description": "Maximum plan→act→observe iterations per agent session."
        },
        "cortex.agent.safeMode": {
          "type": "boolean",
          "default": false,
          "description": "Ask for permission on every non-read action, ignoring session/always grants."
        },
        "cortex.agent.commandTimeout": {
          "type": "number",
          "default": 60,
          "description": "Terminal command timeout in seconds for agent-run commands."
        },
        "cortex.completion.template": {
          "type": "string",
          "enum": [
            "auto",
            "chat",
            "qwen",
            "codegemma",
            "deepseek",
            "starcoder",
            "codellama",
            "codestral"
          ],
          "default": "auto",
          "markdownDescription": "FIM prompt format. `auto` detects from the model id; `chat` forces the chat-based fallback for models without FIM support."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --skip-license -o cortex-code.vsix"
  },
  "dependencies": {
    "@cortex/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
