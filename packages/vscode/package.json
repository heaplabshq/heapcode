{
  "name": "heap-code",
  "displayName": "Heap Code",
  "description": "Model-agnostic AI coding assistant. Works with any OpenAI-compatible API — Ollama, OpenAI, OpenRouter, Groq, LM Studio, vLLM, and more.",
  "version": "0.1.0",
  "publisher": "heapcode",
  "private": true,
  "license": "Apache-2.0",
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#0e1626",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "copilot",
    "ollama",
    "openai",
    "llm",
    "chat",
    "autocomplete",
    "agent",
    "local",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth7631/heapcode"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "heapcode",
          "title": "Heap Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "heapcode": [
        {
          "type": "webview",
          "id": "heapcode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "heapcode.openChat",
        "title": "Heap Code: Open Chat"
      },
      {
        "command": "heapcode.menu",
        "title": "Heap Code: Provider Menu"
      },
      {
        "command": "heapcode.selectProfile",
        "title": "Heap Code: Switch Profile"
      },
      {
        "command": "heapcode.addProfile",
        "title": "Heap Code: Add Provider Profile"
      },
      {
        "command": "heapcode.selectModel",
        "title": "Heap Code: Select Model"
      },
      {
        "command": "heapcode.setApiKey",
        "title": "Heap Code: Set API Key (Active Profile)"
      },
      {
        "command": "heapcode.inlineEdit",
        "title": "Heap Code: Edit Selection"
      },
      {
        "command": "heapcode.explain",
        "title": "Heap Code: Explain"
      },
      {
        "command": "heapcode.fix",
        "title": "Heap Code: Fix"
      },
      {
        "command": "heapcode.refactor",
        "title": "Heap Code: Refactor"
      },
      {
        "command": "heapcode.optimize",
        "title": "Heap Code: Optimize"
      },
      {
        "command": "heapcode.generateTests",
        "title": "Heap Code: Generate Tests"
      },
      {
        "command": "heapcode.generateDocs",
        "title": "Heap Code: Generate Docs"
      },
      {
        "command": "heapcode.reviewCode",
        "title": "Heap Code: Review Code"
      },
      {
        "command": "heapcode.generateCommitMessage",
        "title": "Heap Code: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "heapcode.acceptEdit",
        "title": "Accept Heap Code Edit",
        "icon": "$(check)"
      },
      {
        "command": "heapcode.rejectEdit",
        "title": "Reject Heap Code Edit",
        "icon": "$(close)"
      },
      {
        "command": "heapcode.toggleCompletion",
        "title": "Heap Code: Toggle Completions"
      },
      {
        "command": "heapcode.triggerCompletion",
        "title": "Heap Code: Trigger Completion"
      },
      {
        "command": "heapcode.buildIndex",
        "title": "Heap Code: Build/Refresh Semantic Index"
      },
      {
        "command": "heapcode.clearIndex",
        "title": "Heap Code: Clear Semantic Index"
      },
      {
        "command": "heapcode.openMemory",
        "title": "Heap Code: Open Project Memory"
      },
      {
        "command": "heapcode.addMcpServer",
        "title": "Heap Code: Add MCP Server"
      },
      {
        "command": "heapcode.resetPermissions",
        "title": "Heap Code: Reset Agent Permissions"
      }
    ],
    "submenus": [
      {
        "id": "heapcode.submenu",
        "label": "Heap Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "heapcode.submenu",
          "group": "1_modification@100"
        }
      ],
      "heapcode.submenu": [
        {
          "command": "heapcode.inlineEdit",
          "group": "1_edit@1"
        },
        {
          "command": "heapcode.explain",
          "group": "2_ask@1"
        },
        {
          "command": "heapcode.fix",
          "group": "2_ask@2"
        },
        {
          "command": "heapcode.refactor",
          "group": "2_ask@3"
        },
        {
          "command": "heapcode.optimize",
          "group": "2_ask@4"
        },
        {
          "command": "heapcode.reviewCode",
          "group": "2_ask@5"
        },
        {
          "command": "heapcode.generateTests",
          "group": "3_generate@1"
        },
        {
          "command": "heapcode.generateDocs",
          "group": "3_generate@2"
        }
      ],
      "scm/title": [
        {
          "command": "heapcode.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "heapcode.acceptEdit",
          "group": "navigation@1",
          "when": "resourceScheme == heapcode-proposal"
        },
        {
          "command": "heapcode.rejectEdit",
          "group": "navigation@2",
          "when": "resourceScheme == heapcode-proposal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "heapcode.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "heapcode.triggerCompletion",
        "key": "alt+\\",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Heap Code",
      "properties": {
        "heapcode.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named provider profiles. Each item: `{ name, preset, baseUrl, model, temperature?, maxTokens?, headers?, capabilities? }`. API keys are NOT stored here — use the *Heap Code: Set API Key* command (OS keychain). Presets: `openai`, `ollama`, `azure-openai`, `openrouter`, `together`, `groq`, `nvidia-nim`, `lmstudio`, `vllm`, `localai`, `custom`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "preset",
              "baseUrl",
              "model"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "openai",
                  "ollama",
                  "azure-openai",
                  "openrouter",
                  "together",
                  "groq",
                  "nvidia-nim",
                  "lmstudio",
                  "vllm",
                  "localai",
                  "custom"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "editModel": {
                "type": "string"
              },
              "applyModel": {
                "type": "string"
              },
              "completionModel": {
                "type": "string"
              },
              "agentModel": {
                "type": "string"
              },
              "embeddingsModel": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "maxTokens": {
                "type": "number"
              },
              "contextWindow": {
                "type": "number",
                "description": "Model context window in tokens (prompt + output). Drives the context usage meter and automatic conversation compaction. Default 32768."
              },
              "timeoutMs": {
                "type": "number",
                "description": "Per-request timeout for non-streaming calls (ms). Default 120000."
              },
              "headers": {
                "type": "object"
              },
              "capabilities": {
                "type": "object"
              }
            }
          }
        },
        "heapcode.activeProfile": {
          "type": "string",
          "default": "",
          "description": "Name of the active provider profile. Switch via the status bar."
        },
        "heapcode.customPrompts": {
          "type": "array",
          "default": [],
          "markdownDescription": "User prompt library. Each item: `{ command, title, template }` — usable as `/command` in chat. Templates support `{input}` (text after the command) and `{selection}` (current editor selection).",
          "items": {
            "type": "object",
            "required": [
              "command",
              "template"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "template": {
                "type": "string"
              }
            }
          }
        },
        "heapcode.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Legacy fallback endpoint, used only when `heapcode.profiles` is empty. Prefer profiles."
        },
        "heapcode.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Legacy fallback model, used only when `heapcode.profiles` is empty. Prefer profiles."
        },
        "heapcode.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature."
        },
        "heapcode.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens to generate per response."
        },
        "heapcode.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline (ghost text) code completions."
        },
        "heapcode.completion.delay": {
          "type": "number",
          "default": 250,
          "description": "Debounce in ms before requesting a completion."
        },
        "heapcode.completion.maxLines": {
          "type": "number",
          "default": 12,
          "description": "Maximum lines per multi-line completion."
        },
        "heapcode.completion.maxTokens": {
          "type": "number",
          "default": 200,
          "description": "Max tokens to generate per completion."
        },
        "heapcode.completion.triggerMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "markdownDescription": "`auto`: suggest while typing. `manual`: only on Alt+\\ (Heap Code: Trigger Completion)."
        },
        "heapcode.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers exposed to the agent. Keyed by name. stdio: `{ \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"/path\"] }` — remote: `{ \"url\": \"https://…\", \"transport\": \"http\" }` (or `sse`). MCP tools go through the same permission prompts as other agent actions.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object" },
              "url": { "type": "string" },
              "transport": { "type": "string", "enum": ["http", "sse"] }
            }
          }
        },
        "heapcode.rag.autoIndex": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Index the workspace in the background for semantic search. No-op until the active profile has an `embeddingsModel` (e.g. `nomic-embed-text` on Ollama). Respects `.heapcodeignore`."
        },
        "heapcode.rag.rerank": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Rerank semantic-search hits with the LLM (edit model, else chat model) before using them. Better precision at the cost of one extra small model call per search. Falls back to plain vector order on any failure."
        },
        "heapcode.agent.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable agent mode."
        },
        "heapcode.agent.planFirst": {
          "type": "boolean",
          "default": true,
          "description": "Agent writes a numbered plan first, then executes it step by step."
        },
        "heapcode.agent.maxIterations": {
          "type": "number",
          "default": 50,
          "description": "Maximum plan→act→observe iterations per agent session."
        },
        "heapcode.agent.disabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Agent tools switched off in the chat's tools picker (🔧). Disabled tools are not offered to the model."
        },
        "heapcode.agent.safeMode": {
          "type": "boolean",
          "default": false,
          "description": "Ask for permission on every non-read action, ignoring session/always grants."
        },
        "heapcode.agent.commandTimeout": {
          "type": "number",
          "default": 60,
          "description": "Terminal command timeout in seconds for agent-run commands."
        },
        "heapcode.completion.template": {
          "type": "string",
          "enum": [
            "auto",
            "chat",
            "qwen",
            "codegemma",
            "deepseek",
            "starcoder",
            "codellama",
            "codestral"
          ],
          "default": "auto",
          "markdownDescription": "FIM prompt format. `auto` detects from the model id; `chat` forces the chat-based fallback for models without FIM support."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies -o heap-code.vsix"
  },
  "dependencies": {
    "@heapcode/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/vscode": "1.93.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
