{
  "name": "@heapcode/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./markdown": {
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    },
    "./transcript": {
      "types": "./src/transcript.ts",
      "default": "./src/transcript.ts"
    },
    "./styles.css": "./src/styles.css",
    "./components/Sidebar": {
      "types": "./src/components/Sidebar.tsx",
      "default": "./src/components/Sidebar.tsx"
    },
    "./components/Composer": {
      "types": "./src/components/Composer.tsx",
      "default": "./src/components/Composer.tsx"
    },
    "./components/MessageList": {
      "types": "./src/components/MessageList.tsx",
      "default": "./src/components/MessageList.tsx"
    },
    "./components/Empty": {
      "types": "./src/components/Empty.tsx",
      "default": "./src/components/Empty.tsx"
    },
    "./mark": {
      "types": "./src/mark.ts",
      "default": "./src/mark.ts"
    },
    "./components/ProductToggle": {
      "types": "./src/components/ProductToggle.tsx",
      "default": "./src/components/ProductToggle.tsx"
    },
    "./components/Settings": {
      "types": "./src/components/Settings.tsx",
      "default": "./src/components/Settings.tsx"
    },
    "./components/WorkspacePicker": {
      "types": "./src/components/WorkspacePicker.tsx",
      "default": "./src/components/WorkspacePicker.tsx"
    },
    "./components/ModelPicker": {
      "types": "./src/components/ModelPicker.tsx",
      "default": "./src/components/ModelPicker.tsx"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heapcode/web-host": "workspace:*",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.0",
    "marked-highlight": "^2.1.4",
    "mermaid": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@heapcode/core": "workspace:*",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
